# Force LF for text so Windows/macOS/Linux contributors don't churn diffs.
* text=auto eol=lf

# Unity YAML — these MUST stay text for UnityYAMLMerge to work on conflicts.
*.meta        text eol=lf merge=unityyamlmerge diff
*.unity       text eol=lf merge=unityyamlmerge diff
*.asset       text eol=lf merge=unityyamlmerge diff
*.prefab      text eol=lf merge=unityyamlmerge diff
*.mat         text eol=lf merge=unityyamlmerge diff
*.anim        text eol=lf merge=unityyamlmerge diff
*.controller  text eol=lf merge=unityyamlmerge diff
*.physicMaterial text eol=lf merge=unityyamlmerge diff
*.cs          text eol=lf diff=csharp
*.shader      text eol=lf
*.uxml        text eol=lf
*.uss         text eol=lf

# Git LFS — binary art and audio. Set up with `git lfs install` before cloning.
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# --- LFS exclusions -------------------------------------------------------
# The WebGL template's app icons are small (1-3 kB), generated by
# `npm run icons:app`, and are copied verbatim into the deployed build. If they
# went through LFS, any checkout without `git lfs install` would deploy pointer
# TEXT in place of PNG bytes — the PWA install would then fail with a broken
# icon and no obvious cause. Keep them as ordinary files.
Assets/WebGLTemplates/**/*.png -filter -diff -merge text=auto

# The prototype environment models are kept in the Unity project as ordinary
# repository assets so the playable Bootstrap scene works in a fresh checkout.
Assets/Isoperia/Art/Models/**/*.glb -filter -diff -merge text=auto
