---
/**
 * /bestiary — everything that fights back.
 *
 * The region panels on /world show four creatures because four have portraits.
 * This is the whole roster, and the difference matters: a player deciding
 * whether to walk east wants the numbers for the thing they will meet there,
 * not a curated four.
 *
 * PORTRAITS ARE NOT INVENTED FOR THE OTHER EIGHT
 * Four monsters have a render registered in the media manifest. The rest get a
 * data card and no image. `phase1_creature_silhouettes.png` exists and would
 * fill the space, and using it would be the editor-screenshot mistake in a new
 * costume: a picture that is not of the thing it is captioned as. An empty
 * space that says nothing false is better than a filled one that does.
 *
 * DROP CHANCES ARE REAL PROBABILITIES
 * The export stores main-table drops as weights, which are correct for the
 * engine and useless to a reader — "weight 140" means nothing without the
 * total. gamedata.ts converts them once, at build time. Tertiary and pet rolls
 * already carry explicit chances and pass through untouched, because rescaling
 * those against the main table would quietly make them wrong.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFigure from "../components/MediaFigure.astro";
import ItemIcon from "../components/ItemIcon.astro";
import { bestiary, TICK_MS, counts } from "../lib/gamedata";
import type { MediaId } from "../lib/media";
import { gamePath } from "../lib/site";

const beasts = bestiary();

/** The four that have a registered render. Everything else shows no image. */
const PORTRAITS: Record<string, MediaId> = {
  dire_wolf: "dire-wolf",
  frost_imp: "frost-imp",
  bog_husk: "bog-husk",
  cave_slasher: "cave-slasher",
};

const pct = (n: number): string => {
  if (n >= 0.1) return `${Math.round(n * 100)}%`;
  if (n >= 0.01) return `${(n * 100).toFixed(1)}%`;
  if (n <= 0) return "—";
  return `1 in ${Math.round(1 / n).toLocaleString()}`;
};

const TABLE_LABEL = {
  main: "Drop",
  tertiary: "Rare",
  pet: "Pet",
} as const;

const withPortraits = Object.keys(PORTRAITS).length;

/* The drop tables, shipped to the browser for the roll simulator.
 *
 * Emitted as an inert <script type="application/json"> rather than inlined
 * into a module: the content security policy forbids inline executable script,
 * and a JSON block is data the parser never runs. It is the same numbers the
 * table above renders — one source, so the simulator cannot disagree with the
 * page it sits on.
 *
 * Roughly 4 KB for twelve creatures, which is why it ships whole rather than
 * being fetched per creature: a request per click would cost more than this.
 */
const rollTables = Object.fromEntries(
  beasts.map((b) => [
    b.id,
    {
      name: b.name,
      xp: b.xpTotal,
      drops: b.drops.map((d) => ({
        id: d.itemId,
        n: d.label,
        c: d.chance,
        min: d.min,
        max: d.max,
        t: d.table,
      })),
    },
  ]),
);
---

<BaseLayout
  title="Bestiary"
  pathname="/bestiary/"
  description="Every creature in Isoperia with its level, hitpoints, max hit, experience and full drop table — read from the game's own combat data."
>
  <section class="head" data-region="cinder">
    <div class="wrap">
      <p class="eyebrow">Bestiary</p>
      <h1 data-reveal>Everything that fights back.</h1>
      <p class="lede" data-reveal>
        All {beasts.length} creatures, with the numbers the engine actually rolls: what they
        hit for, what they are worth, and what they drop. Read from the combat data when this
        page is built, so it cannot drift from the build you'd play.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <ul class="beasts">
        {
          beasts.map((b) => (
            <li class="beast" data-reveal id={b.id}>
              <div class="beast__head">
                {PORTRAITS[b.id] ? (
                  <MediaFigure
                    id={PORTRAITS[b.id] as MediaId}
                    class="beast__plate"
                    compact
                    widths={[160, 320]}
                    sizes="140px"
                  />
                ) : (
                  <div class="beast__noplate">
                    <span class="beast__initial" aria-hidden="true">
                      {b.name.charAt(0)}
                    </span>
                    <span class="visually-hidden">No portrait for {b.name} yet.</span>
                  </div>
                )}

                <div class="beast__id">
                  <h2 class="beast__name">
                    {b.name}
                    {b.boss && <span class="tag beast__boss">Boss</span>}
                  </h2>
                  <dl class="stats">
                    <div>
                      <dt>Level</dt>
                      <dd>{b.level}</dd>
                    </div>
                    <div>
                      <dt>Hitpoints</dt>
                      <dd>{b.hp}</dd>
                    </div>
                    <div>
                      <dt>Max hit</dt>
                      <dd>{b.maxHit}</dd>
                    </div>
                    <div>
                      <dt>Attacks every</dt>
                      <dd>{((b.attackTick * TICK_MS) / 1000).toFixed(1)}s</dd>
                    </div>
                    <div>
                      <dt>Experience</dt>
                      <dd>{b.xpTotal}</dd>
                    </div>
                    <div>
                      <dt>Respawn</dt>
                      <dd>{b.respawnSeconds}s</dd>
                    </div>
                  </dl>
                  <p class="beast__note">
                    Notices you from {b.aggroRange} tiles
                    {b.ranged ? " and attacks at range" : ""}. Trains{" "}
                    {b.xp.map((x) => `${x.skill} ${x.amount}`).join(", ")}.
                  </p>
                </div>
              </div>

              <div class="scroll-x">
                <table class="table beast__drops">
                  <caption class="visually-hidden">Drop table for {b.name}</caption>
                  <thead>
                    <tr>
                      <th>Drops</th>
                      <th class="num">Quantity</th>
                      <th class="num">Chance</th>
                    </tr>
                  </thead>
                  <tbody>
                    {b.drops.map((d) => (
                      <tr>
                        <td>
                          <ItemIcon itemId={d.itemId} size={24} />
                          <a href={`/items/${d.itemId}/`}>{d.label}</a>
                          {d.table !== "main" && (
                            <span class="tag beast__kind">{TABLE_LABEL[d.table]}</span>
                          )}
                        </td>
                        <td class="num">
                          {d.min === d.max ? d.min : `${d.min}–${d.max}`}
                        </td>
                        <td class="num">{pct(d.chance)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* The roll simulator. Progressive: hidden until the module runs,
                  because a button that does nothing is worse than no button. */}
              <div class="roll" data-roll={b.id} hidden>
                <div class="roll__bar">
                  <button class="btn btn--compact" data-kills="1">
                    Kill one
                  </button>
                  <button class="btn btn--compact btn--secondary" data-kills="50">
                    ×50
                  </button>
                  <button class="btn btn--compact btn--secondary" data-kills="1000">
                    ×1000
                  </button>
                  <button class="roll__reset" data-reset hidden>
                    Reset
                  </button>
                </div>
                <p class="roll__tally" data-tally aria-live="polite" />
                <ul class="roll__loot" data-loot />
              </div>
            </li>
          ))
        }
      </ul>
      <p class="note roll__caveat" data-reveal>
        The roll buttons simulate the drop table printed above, using the same weights the
        engine rolls. It is a simulation of the published numbers, not a recording of play
        — it cannot tell you anything the table does not already say, it just says it
        faster.
      </p>
    </div>
  </section>

  <section class="block" data-region="miregate">
    <div class="wrap">
      <h2 data-reveal>How to read this</h2>
      <p class="note" data-reveal>
        <strong>Chance</strong> on the main table is that item's share of one roll, so the column
        sums to 100% — every kill drops something from it. <strong>Rare</strong> and
        <strong>Pet</strong> rows are separate rolls with their own odds and do not compete
        with the main table or with each other.
      </p>
      <p class="note">
        {withPortraits} of these {beasts.length} have a model render to show. The rest are listed
        without one rather than borrowed from a silhouette sheet — a picture that is not of
        the creature it sits beside is worse than no picture. Of {counts.monsters} monsters
        in the game data, every one is here.
      </p>
      <p class="cta-row" data-reveal>
        <a class="btn btn--lg" href={gamePath} data-exit>Go and meet them</a>
      </p>
    </div>
  </section>
  <script
    type="application/json"
    id="roll-tables"
    set:html={JSON.stringify(rollTables)}
  />
</BaseLayout>

<script>
  /* The drop-table roll simulator.
   *
   * WHY IT ROLLS RATHER THAN CALCULATES
   * The table already prints every probability. A player reading "1 in 2,500"
   * knows the number and has no feel for it; rolling two thousand kills and
   * still not seeing the pet is the number, felt. That is the whole reason this
   * exists, and it is why the tally reports kills rather than expected value.
   *
   * The maths is the engine's own: main-table drops are weighted shares of one
   * roll, and tertiary and pet entries are independent chances rolled
   * separately — which is why a kill can yield a main drop AND a pet.
   */
  interface Row {
    id: string;
    n: string;
    c: number;
    min: number;
    max: number;
    t: "main" | "tertiary" | "pet";
  }
  interface Table {
    name: string;
    xp: number;
    drops: Row[];
  }

  const raw = document.querySelector<HTMLScriptElement>("#roll-tables")?.textContent;
  if (raw) {
    const tables = JSON.parse(raw) as Record<string, Table>;

    for (const panel of document.querySelectorAll<HTMLElement>("[data-roll]")) {
      const table = tables[panel.dataset.roll ?? ""];
      if (!table) continue;
      panel.hidden = false;

      const tally = panel.querySelector<HTMLElement>("[data-tally]");
      const lootEl = panel.querySelector<HTMLElement>("[data-loot]");
      const reset = panel.querySelector<HTMLButtonElement>("[data-reset]");

      const main = table.drops.filter((d) => d.t === "main");
      const extras = table.drops.filter((d) => d.t !== "main");
      const mainTotal = main.reduce((sum, d) => sum + d.c, 0);

      let kills = 0;
      const got = new Map<string, { n: string; qty: number; rare: boolean }>();

      const take = (d: Row): void => {
        const qty = d.min + Math.floor(Math.random() * (d.max - d.min + 1));
        const cur = got.get(d.id);
        if (cur) cur.qty += qty;
        else got.set(d.id, { n: d.n, qty, rare: d.t !== "main" });
      };

      const rollOnce = (): void => {
        kills++;
        // One weighted roll over the main table.
        if (mainTotal > 0) {
          let r = Math.random() * mainTotal;
          for (const d of main) {
            r -= d.c;
            if (r <= 0) {
              take(d);
              break;
            }
          }
        }
        // Then each rare and pet chance, independently.
        for (const d of extras) if (Math.random() < d.c) take(d);
      };

      const render = (): void => {
        if (tally) {
          tally.textContent =
            kills === 0
              ? ""
              : `${kills.toLocaleString()} kill${kills === 1 ? "" : "s"} · ` +
                `${(kills * table.xp).toLocaleString()} xp`;
        }
        if (reset) reset.hidden = kills === 0;
        if (!lootEl) return;
        lootEl.replaceChildren(
          ...[...got.values()]
            .sort((a, b) => Number(b.rare) - Number(a.rare) || b.qty - a.qty)
            .map((g) => {
              const li = document.createElement("li");
              if (g.rare) li.className = "is-rare";
              const q = document.createElement("strong");
              q.textContent = g.qty.toLocaleString();
              li.append(q, document.createTextNode(` ${g.n}`));
              return li;
            }),
        );
      };

      for (const btn of panel.querySelectorAll<HTMLButtonElement>("[data-kills]")) {
        btn.addEventListener("click", () => {
          const n = Number(btn.dataset.kills) || 1;
          // A thousand rolls is a handful of microseconds; no need to yield.
          for (let i = 0; i < n; i++) rollOnce();
          render();
        });
      }
      reset?.addEventListener("click", () => {
        kills = 0;
        got.clear();
        render();
      });
    }
  }
</script>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2xs);
  }

  .head {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--text-muted);
    margin-top: var(--space-sm);
  }

  .block {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-sm) var(--space-lg);
  }

  .beasts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .beast {
    padding: var(--space-lg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
  }

  .beast__head {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }

  /* The same deliberately light plate the region panels use: these renders are
     single figures on a pale studio backdrop, and inheriting the surface would
     put a bright square inside a dark card. */
  .beast__plate {
    flex: 0 0 auto;
    width: 7rem;
    background: #eceef1;
    border-radius: var(--radius-md);
  }

  .beast__plate :global(img) {
    border-color: transparent;
  }

  /* No portrait, and it does not pretend otherwise. A plain monogram plate the
     same size as a real one, so the grid stays even without implying there is
     a picture missing from this particular card. */
  .beast__noplate {
    flex: 0 0 auto;
    width: 7rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }

  .beast__initial {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--text-muted);
    opacity: 0.55;
  }

  .beast__id {
    min-width: 0;
  }

  .beast__name {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
  }

  .beast__boss {
    color: var(--district-cinder);
    border-color: currentColor;
  }

  .beast__kind {
    margin-left: var(--space-xs);
    font-size: var(--text-2xs);
    padding: 0 var(--space-2xs);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(5.5rem, 1fr));
    gap: var(--space-2xs) var(--space-sm);
    margin: 0 0 var(--space-sm);
  }

  .stats dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stats dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .beast__note {
    color: var(--text-muted);
    font-size: var(--text-xs);
    max-width: none;
  }

  .beast__drops {
    font-size: var(--text-sm);
  }

  .cta-row {
    margin-top: var(--space-2xl);
    max-width: none;
  }

  /* --- the roll simulator ------------------------------------------------ */
  .roll {
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-subtle);
  }
  .roll__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: center;
  }
  .roll__reset {
    font: inherit;
    font-size: var(--text-xs);
    background: none;
    border: 0;
    color: var(--text-muted);
    text-decoration: underline;
    cursor: pointer;
    margin-left: auto;
  }
  .roll__tally {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    min-height: 1.2em;
  }
  .roll__loot {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-xs);
    font-size: var(--text-sm);
  }
  .roll__loot li {
    color: var(--text-muted);
  }
  .roll__loot strong {
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  /* A rare is the whole point of rolling. It gets to look like one. */
  .roll__loot .is-rare {
    color: var(--mark-gold);
  }
  .roll__loot .is-rare strong {
    color: var(--mark-gold);
  }
  .roll__caveat {
    margin-top: var(--space-lg);
  }
</style>
