---
/**
 * Home — the landing page (blueprint Phase 4, §5).
 *
 * Eight sections, each with a job: hero, pitch + trust row, the five systems,
 * the mainland map, the progression curve, the devlog, the closing CTA, and the
 * footer (supplied by BaseLayout).
 *
 * This page composes; it does not style. Everything visual comes from the Phase
 * 2 token and component layers or from the sections themselves.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Pillars from "../components/sections/Pillars.astro";
import WorldMap from "../components/sections/WorldMap.astro";
import Progression from "../components/sections/Progression.astro";
import Devlog from "../components/sections/Devlog.astro";
import PlayCta from "../components/sections/PlayCta.astro";
---

<BaseLayout title="Home" pathname="/" isHome>
  <Hero />
  <Pillars />
  <WorldMap />
  <Progression />
  <Devlog />
  <PlayCta />
</BaseLayout>
