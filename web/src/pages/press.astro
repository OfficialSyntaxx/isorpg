---
/**
 * /press — the press kit (blueprint §4.1).
 *
 * Three honesty constraints shape this page:
 *
 * 1. The press contact in site.config.json is null. A press page whose contact
 *    is a dead mailto: is worse than one that says plainly there is no route
 *    yet, so the Contact block says exactly that.
 * 2. Attribution is an obligation, not a courtesy. The project's licence
 *    acceptance record is summarised here rather than quietly omitting the
 *    third-party CC0 work it covers.
 * 3. Every image comes from the media manifest, which states whether it is a
 *    capture or an illustration and renders that as a badge. A press page is
 *    the one page whose images get reproduced somewhere else, so the label has
 *    to travel with the picture rather than sitting in a paragraph a crop can
 *    lose.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import MediaFigure from "../components/MediaFigure.astro";
import { site, origin, gamePath } from "../lib/site";
import { counts } from "../lib/gamedata";
import { media, type MediaId } from "../lib/media";

const facts: { k: string; v: string }[] = [
  { k: "Title", v: site.name },
  { k: "Genre", v: "Settlement builder / character-centric RPG" },
  { k: "Platform", v: "Browser (WebGL), installable as a PWA, offline-capable" },
  { k: "Price", v: "Free" },
  { k: "Engine", v: "Unity 6 (WebGL); an earlier prototype ran on three.js" },
  { k: "Status", v: "Pre-alpha, playable" },
  { k: "Accounts", v: "None — saves are local, with import and export" },
  { k: "First load", v: "~50 MB Brotli-compressed, then cached" },
  {
    k: "Content",
    v: `${counts.skills} skills · ${counts.items} items · ${counts.recipes} recipes · ${counts.monsters} monsters · ${counts.buildings} buildings`,
  },
];

/*
 * WHAT IS NOT HERE, AND WHY
 *
 * unity-town-runtime-2026-08-23.jpg was published on this page and has been
 * removed. It is a screenshot of the Unity EDITOR, not of the game: hierarchy
 * panel, inspector, and a console showing debug output, internal object names
 * and a local bridge port. The game view inside it is the old isometric
 * prototype, which is not what Isoperia is any more.
 *
 * Its alt text described "the Hearthvale settlement at runtime, seen from the
 * third-person follow camera" — a picture that does not exist in that file. A
 * screen-reader user was told about a plaza while everyone else saw an IDE.
 *
 * scripts/verify-no-internals.cjs could not have caught this: it reads the text
 * of built pages and cannot see inside a PNG. scripts/verify-media.cjs is the
 * check that covers the gap — every image published by this site must be
 * registered in web/src/lib/media.ts with a declared provenance, and that file
 * blocks this one by name with the reason.
 */
const shots: MediaId[] = ["hearthvale-east-road", "overworld-layout", "gameplay-loop"];
---

<BaseLayout
  title="Press kit"
  pathname="/press/"
  description="Press kit for Isoperia: logline, factsheet, screenshots, and licence information."
>
  <section class="head">
    <div class="wrap">
      <p class="eyebrow">Press kit</p>
      <h1 data-reveal>{site.name}</h1>
      <p class="logline" data-reveal>{site.tagline}</p>
      <p class="note" data-reveal>
        Everything on this page may be reproduced for coverage. Each image below says
        whether it is a capture from a real build or concept art — please carry that
        distinction if you reproduce one.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 data-reveal>Factsheet</h2>
      <div class="scroll-x" data-reveal>
        <table class="table">
          <tbody>
            {
              facts.map((f) => (
                <tr>
                  <th scope="row">{f.k}</th>
                  <td>{f.v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note note--after">
        The content counts are read from the game's own data export when this page is
        built, so they cannot drift from the build you'd play.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 data-reveal>Screenshots</h2>
      <p class="note" data-reveal>
        Right-click to save. Higher-resolution originals are available on request.
      </p>

      <div class="shots">
        {
          shots.map((id) => (
            <MediaFigure
              id={id}
              data-reveal
              sizes="(min-width: 48rem) 30rem, 100vw"
              widths={[480, 960]}
            />
          ))
        }
      </div>
      <p class="note note--after">
        The badge on each image is part of the image. If you reproduce one, please carry
        it: <strong>{media["overworld-layout"].caption}</strong> is illustration, not a screenshot,
        and running it as one would misrepresent how the game looks.
      </p>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 data-reveal>Licence and attribution</h2>
      <div class="callout" data-reveal>
        <span class="callout__icon" aria-hidden="true">📜</span>
        <span class="callout__title">Most art is original; some is CC0</span>
        <div class="callout__body">
          <p>
            The great majority of Isoperia's models are original project art, authored in
            Blender. Two third-party sources are used, both CC0: a Poly Haven terrain
            texture and a curated subset of Kenney's Fantasy Town Kit. Every shipped asset
            has an acceptance record behind it — owner, source, licence status and a
            technical review — and press enquiries about any specific asset are welcome.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 data-reveal>Contact</h2>
      {
        /* Both the press address and every social link in site.config.json are
           still null. This block used to fall back to a repository link, which
           is no longer published — so it says plainly that there is no contact
           route yet rather than pointing at one that does not exist. Filling in
           contact.press, or any social url, makes this section useful. */
      }
      <p class="note" data-reveal>
        There is no press contact address yet. This section will carry one as soon as
        there is a role address to publish; until then there is no route to the project
        from this page, and saying so is more useful than a dead link.
      </p>
      <p class="cta-row" data-reveal>
        <a class="btn" href={gamePath} data-exit>Play in your browser</a>
      </p>
      <p class="note note--after">
        Canonical URL: <code>{origin}</code>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-2xs);
  }

  .head {
    padding-block: var(--space-3xl) var(--space-xl);
  }

  .logline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-strong);
    line-height: var(--leading-snug);
    margin-top: var(--space-sm);
    max-width: 34ch;
  }

  .block {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
  }

  .note {
    color: var(--text-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-sm) var(--space-lg);
  }

  .note--after {
    margin-top: var(--space-sm);
    margin-bottom: 0;
  }

  /* Row headers in the factsheet are <th scope="row">, so they need the label
     treatment rather than the column-header treatment .table gives them. */
  .table th[scope="row"] {
    text-transform: none;
    letter-spacing: normal;
    font-size: var(--text-sm);
    width: 12rem;
    color: var(--text-muted);
  }

  .shots {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    max-width: none;
  }
</style>
