---
/**
 * /wiki/ — renders WIKI.md (repo root) at build time.
 *
 * WIKI.md is generated from the game's own data files (scripts/gen-wiki.cjs)
 * and is prose-with-tables, not a structured record — see src/lib/markdown.ts
 * for why this renders the markdown rather than parsing it. At 300+ table
 * rows, the table of contents matters more here than on any other page, so
 * every h2/h3 gets a TOC entry.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderDoc } from "../lib/markdown";

const { html, headings } = renderDoc("WIKI.md");
---

<BaseLayout
  title="Wiki"
  pathname="/wiki/"
  description="Skills, items, monsters, crafting, and guides for Isoperia — generated straight from the game's own data."
>
  <section class="doc">
    <div class="wrap">
      <header class="doc__intro" data-reveal>
        <h1>Wiki</h1>
        <p>
          This wiki is generated from the game's own data files, not written by hand —
          every number, drop, and recipe on this page is read straight from the code, so
          it cannot drift out of date the way a hand-maintained wiki does.
        </p>
      </header>

      <div class="doc-grid">
        <nav class="toc" aria-label="Wiki sections">
          <p class="toc__title">On this page</p>
          <ul>
            {
              headings.map((h) => (
                <li class:list={["toc__item", h.depth === 3 && "toc__item--sub"]}>
                  <a href={`#${h.id}`}>{h.text}</a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="prose" set:html={html} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page-local only. The shared .prose, .toc, .table-wrap and .doc-grid rules
     live in src/styles/components.css — this file must not restate them, or the
     two drift and a change in one place stops taking effect. */
  .doc {
    padding-block: var(--space-3xl) var(--space-4xl);
  }

  .doc__intro {
    margin-bottom: var(--space-xl);
  }

  .doc__intro p {
    color: var(--text-muted);
    margin-top: var(--space-sm);
  }

  .toc__title {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-xs);
  }
</style>
