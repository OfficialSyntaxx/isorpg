---
/**
 * Site footer.
 *
 * Renders only the socials that have a url in site.config.json — an unfilled
 * placeholder produces a missing link, never a dead one (see lib/site.ts).
 *
 * The asset-credits line is an obligation, not a courtesy: the project uses CC0
 * and licensed assets recorded in docs/ASSET_CREDITS.md.
 */
import { site, socials } from "../lib/site";

const links = socials();

/* Secondary routes: real pages that do not need to crowd the header.
 *
 * This list has to be COMPLETE, not merely secondary. Phase 14 added /bestiary
 * and /save to the header and not to this list, and the header was at the same
 * time silently hiding its overflow — so for a while the two newest pages on
 * the site had no reachable link on a phone at all. The footer is the fallback
 * for anything the header cannot show; a fallback with gaps in it is not one.
 */
const pages = [
  { href: "/features/", label: "Features" },
  { href: "/world/", label: "World" },
  { href: "/items/", label: "Items" },
  { href: "/bestiary/", label: "Bestiary" },
  { href: "/quests/", label: "Quests" },
  { href: "/devlog/", label: "Devlog" },
  { href: "/wiki/", label: "Wiki" },
  { href: "/roadmap/", label: "Roadmap" },
  { href: "/press/", label: "Press kit" },
  { href: "/save/", label: "Saves" },
  { href: "/devlog/rss.xml", label: "RSS" },
];

const legal = [
  { href: "/legal/privacy/", label: "Privacy" },
  { href: "/legal/terms/", label: "Terms" },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__blurb">
      <strong>{site.name}</strong> — {site.shortDescription}
    </p>

    <nav class="footer__links" aria-label="Pages">
      {pages.map((p) => <a href={p.href}>{p.label}</a>)}
    </nav>

    {
      links.length > 0 && (
        <nav class="footer__links" aria-label="Elsewhere">
          {links.map((s) => (
            <a href={s.url} rel="noopener noreferrer">
              {s.label}
            </a>
          ))}
        </nav>
      )
    }

    <nav class="footer__legal" aria-label="Legal">
      {legal.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <p class="footer__fine">
      © {year}{" "}{site.name}. Built in the open.
    </p>
  </div>
</footer>

<style>
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__blurb {
    max-width: var(--measure-prose);
  }

  .footer__blurb strong {
    font-family: var(--font-display);
    color: var(--text-strong);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
  }

  .footer__fine {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
</style>
