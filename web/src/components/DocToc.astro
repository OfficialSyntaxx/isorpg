---
/**
 * The contents list for a long document page (/wiki, /roadmap).
 *
 * WHY A <details> AND NOT A <nav>
 * The wiki's contents list is 51 entries. On a desktop sidebar that is a
 * feature; on a phone, where the list is a full-width block at the top of the
 * single column, it is a screen and a half of links before the reader reaches
 * a single word of content.
 *
 * IT SHIPS CLOSED, AND THE REASON IT USED TO SHIP OPEN WAS WRONG.
 * The original argument was that shipping open kept the list available without
 * JavaScript, "rather than hiding content behind a control that needs a script
 * to be useful". That premise is false: <details> is native HTML and its
 * summary toggles with no script at all. Nothing was ever gated behind
 * JavaScript.
 *
 * What shipping open actually bought was a layout shift. The list rendered at
 * full height, then a script collapsed it on phones, and the entire document
 * jumped up by around 700px on every mobile load. Lighthouse measured the
 * result on /wiki as a cumulative layout shift of 0.37 — "good" is below 0.1 —
 * and CLS is a quarter of the mobile performance score.
 *
 * Closed costs a no-JS phone reader one tap, and a no-JS desktop reader one tap
 * as well in the worst case; the CSS below reveals the list at sidebar widths
 * without needing the open attribute at all, so that case is covered too. With
 * JavaScript, initDocToc opens it at >=64rem exactly as before.
 */
import type { Heading } from "../lib/markdown";

interface Props {
  headings: Heading[];
  label: string;
}

const { headings, label } = Astro.props;
---

<details class="toc" data-toc>
  {
    /* No aria-label on the summary.
      It had one, and it was a WCAG 2.5.3 failure: an aria-label REPLACES the
      accessible name, so the control read as "Wiki sections" while visibly
      saying "On this page". Someone driving the page by voice would say what
      they can see and match nothing. The visible text is the name now, and the
      descriptive label moved to the nav landmark below, which is what a
      landmark label is for. Lighthouse scored /wiki 95 on accessibility until
      this changed. */
  }
  <summary class="toc__summary">
    <span class="toc__title">On this page</span>
    <span class="toc__count">{headings.length}</span>
  </summary>
  <nav class="toc__nav" aria-label={label}>
    <ul class="toc__list">
      {
        headings.map((h) => (
          <li class:list={["toc__item", h.depth === 3 && "toc__item--sub"]}>
            <a href={`#${h.id}`}>{h.text}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
