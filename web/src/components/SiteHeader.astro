---
/**
 * Site header. Routes that do not exist yet are deliberately absent rather than
 * present-and-dead — a nav link to a 404 is worse than no link. Phase 6 adds
 * the content routes and they appear here then.
 */
import ThemeToggle from "./ThemeToggle.astro";
import { site, gamePath } from "../lib/site";

/**
 * Primary navigation. Only routes that exist are listed — a nav entry pointing
 * at a 404 is worse than no entry. Secondary routes (roadmap, press) live in
 * the footer rather than crowding this row on a phone.
 */
const nav: { href: string; label: string }[] = [
  { href: "/features/", label: "Features" },
  { href: "/world/", label: "World" },
  { href: "/devlog/", label: "Devlog" },
  { href: "/wiki/", label: "Wiki" },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/">{site.name}</a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            aria-current={path === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <ThemeToggle />
      <a class="btn" href={gamePath} data-exit>Play</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--glass-bg);
    border-bottom: 1px solid var(--border-subtle);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      background: var(--surface-raised);
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  .site-header__brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
  }
</style>
