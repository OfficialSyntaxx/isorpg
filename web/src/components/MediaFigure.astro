---
/**
 * The only way an image reaches a page.
 *
 * Takes a manifest id rather than a file, so alt text, caption and provenance
 * travel with the image instead of being retyped — and mistyped — per page. The
 * provenance badge is not optional: an image whose kind is "concept" says so
 * wherever it appears, because press pages get reproduced and a caption that
 * only lives in the article's paragraph does not survive a crop.
 *
 * A placeholder entry renders as a reserved, labelled slot. It occupies its
 * final aspect ratio from first paint, so dropping real footage in later shifts
 * nothing — the layout is already the layout.
 */
import { Image } from "astro:assets";
import { media, provenanceLabel, provenanceNote, type MediaId } from "../lib/media";

interface Props {
  id: MediaId;
  /** Anything else — `data-reveal` and friends — lands on the <figure>. */
  [key: `data-${string}`]: unknown;
  /** Rendered widths for the srcset. Defaults suit a full-width figure. */
  widths?: number[];
  sizes?: string;
  /** The first image on a page may want eager loading; everything else lazy. */
  eager?: boolean;
  /**
   * Compact: the provenance badge sits on the image as a small chip instead of
   * on a caption line, and the caption text is dropped. For a thumbnail beside
   * prose, where a full caption row would outweigh the picture.
   *
   * The badge itself is never optional. Dropping it is what got an editor
   * screenshot published as gameplay.
   */
  compact?: boolean;
  class?: string;
}

const {
  id,
  widths = [480, 960, 1440],
  sizes = "(min-width: 60rem) 60rem, 100vw",
  eager = false,
  compact = false,
  class: className,
  ...rest
} = Astro.props;

const item = media[id];
---

<figure class:list={["media", compact && "media--compact", className]} {...rest}>
  {
    item.kind === "placeholder" ? (
      <div class="media__slot" data-ratio={item.ratio}>
        <p class="media__slot-text">{item.expects}</p>
      </div>
    ) : (
      <div class="media__frame">
        <Image
          src={item.src}
          alt={item.alt}
          widths={widths}
          sizes={sizes}
          loading={eager ? "eager" : "lazy"}
          decoding={eager ? "sync" : "async"}
        />
        {/* Overlays — an interactive map layer, say — sit here, above the
            image and inside its box, so they inherit its exact geometry. */}
        <slot />
      </div>
    )
  }

  <figcaption class="media__cap">
    <span class:list={["media__badge", `media__badge--${item.kind}`]}>
      {provenanceLabel[item.kind]}
    </span>
    {!compact && <span class="media__text">{item.caption}</span>}
    <span class="visually-hidden">. {provenanceNote[item.kind]}</span>
  </figcaption>
</figure>

<style>
  .media {
    margin: 0;
  }

  /* Compact: the badge moves onto the picture. It keeps a solid plate behind it
     because these thumbnails are renders on a pale backdrop, and a transparent
     chip on pale grey is a contrast failure waiting for the first dark theme
     screenshot. */
  .media--compact .media__cap {
    position: absolute;
    inset-block-end: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    margin: 0;
    z-index: 1;
  }

  /* overflow: hidden is the structural half of this.
     The badge is absolutely positioned over a thumbnail that may be narrower
     than the label. Unclipped, it escaped the picture and painted over the
     value next to it — a creature card that silently lost its level. Clipping
     makes that failure visible on the badge itself rather than destructive to
     whatever happens to sit beside it. */
  .media--compact {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  /* Sized to sit on a thumbnail rather than under a figure: the shared tracking
     and 2xs step are set for a caption line and are simply too wide here. */
  .media--compact .media__badge {
    background: var(--surface-page);
    border-color: var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    padding: 0.1em 0.35em;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .media__frame {
    position: relative;
    line-height: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  /* The empty slot. Deliberately plain: a decorated placeholder reads as a
     finished element that failed to load. */
  .media__slot {
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px dashed var(--border-strong);
    background: var(--surface-raised);
  }

  /* One rule per ratio the manifest is allowed to declare.
     The ratio arrives on the slot as a data attribute rather than a style
     attribute, because the content security policy blocks inline styles — and a
     slot with no reserved height would shift the page the moment real footage
     replaced it, which is the whole thing the slot exists to prevent. The union
     type in media.ts and scripts/verify-media.cjs hold this list to one set. */
  .media__slot[data-ratio="16 / 9"] {
    aspect-ratio: 16 / 9;
  }

  .media__slot[data-ratio="4 / 3"] {
    aspect-ratio: 4 / 3;
  }

  .media__slot[data-ratio="1 / 1"] {
    aspect-ratio: 1 / 1;
  }

  .media__slot-text {
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-align: center;
    text-wrap: balance;
    max-width: 40ch;
  }

  .media__cap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-xs);
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .media__badge {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding: 0.15em 0.5em;
    border-radius: var(--radius-sm);
    border: 1px solid currentColor;
    white-space: nowrap;
  }

  /* Capture is the only badge that gets the accent. Concept art borrowing the
     "this is the game" colour is exactly the confusion the badge prevents. */
  .media__badge--capture {
    color: var(--accent);
  }

  .media__badge--concept,
  .media__badge--art,
  .media__badge--placeholder {
    color: var(--text-muted);
  }
</style>
