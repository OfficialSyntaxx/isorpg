---
/**
 * §5.4 — the mainland.
 *
 * Content is the spatial contract in docs/WORLD_LAYOUT.md, not invented
 * geography: a safe settlement at the centre, four outer regions whose terrain
 * and resource loop reinforce one another, and a high-risk destination east.
 * District colours are the in-game route-anchor colours (UPDATES.md 2026-08-26).
 *
 * ACCESSIBILITY — WHY THE BUTTONS ARE THE INTERACTIVE LAYER
 * Blueprint §9.2 is explicit that an SVG map which only works with a mouse
 * fails. Rather than bolt tabindex and roles onto SVG paths — which is fragile
 * and announces badly — the real interactive layer is a list of ordinary
 * buttons. The SVG is decorative and reacts to them.
 *
 * That has three consequences worth keeping: keyboard and screen-reader support
 * come free from the button element; the list is itself the text equivalent the
 * blueprint requires, so there is no separate "accessible version" to maintain;
 * and hovering the map is a nice-to-have rather than the only way in.
 */
const districts = [
  {
    id: "hearthvale",
    name: "Hearthvale",
    role: "Safe home and construction",
    body: "An open plaza, a market, a campfire and the build plots. Buildings sit around a walkable square rather than ringing you in.",
    mod: "",
  },
  {
    id: "wildwood",
    name: "Wildwood",
    role: "First gathering route",
    body: "Northwest forest. Normal and oak trees, a shrine ruin as the arrival landmark, and the early wildlife that teaches you to watch your health.",
    mod: "wildwood",
  },
  {
    id: "frostwatch",
    name: "Frostwatch",
    role: "Mining progression",
    body: "Northeast highlands. Copper and tin near the road, iron and coal deeper in, with a mine and snow-crag silhouette visible from the route.",
    mod: "frostwatch",
  },
  {
    id: "miregate",
    name: "Miregate",
    role: "Mid-game route",
    body: "Southwest mire. Willow stands, fishing water, bog husks, and hazardous paths where the crossing matters more than the fight.",
    mod: "miregate",
  },
  {
    id: "sunmere",
    name: "Sunmere",
    role: "Food and town growth",
    body: "Southeast lowlands. Farm plots and fishing feeding the cooking and carpentry loop, with mills and a granary anchoring the shoreline.",
    mod: "wildwood",
  },
  {
    id: "cinder",
    name: "Cinder Hollow",
    role: "High-risk destination",
    body: "Outer east. The dungeon approach and a boss clearing, lit in pools. Every route is a loop back to town — this one you earn.",
    mod: "cinder",
  },
] as const;
---

<section class="world seam" data-region="wildwood" id="world">
  <div class="wrap">
    <p class="eyebrow">The mainland</p>
    <h2 data-reveal>One place, six ways it changes</h2>
    <p class="world__lede" data-reveal>
      A safe centre, landmark-led roads, and four outer regions whose terrain, resources
      and danger reinforce one another. Every route loops back to town.
    </p>

    <div class="world__grid">
      <!-- Decorative: every region below is reachable as a button. -->
      <svg
        class="world__map"
        viewBox="0 0 720 540"
        role="img"
        aria-label="Stylised survey map of the Isoperia mainland: a forested northwest, highlands northeast, a mire southwest, farmland southeast, a central settlement, and a dungeon on the far east."
        data-map
      >
        <defs>
          <pattern id="survey" width="24" height="24" patternUnits="userSpaceOnUse">
            <path
              d="M24 0H0v24"
              fill="none"
              stroke="currentColor"
              stroke-width="0.5"
              opacity="0.18"></path>
          </pattern>
        </defs>

        <rect
          x="28"
          y="28"
          width="664"
          height="484"
          rx="10"
          fill="url(#survey)"
          stroke="currentColor"
          stroke-width="1.5"
          opacity="0.85"></rect>

        <!-- Regions.
             Each carries a symbolic glyph, because four flat rectangles read as
             a bar chart rather than a place — real device feedback, and fair.
             Glyphs are drawn in translucent black so they sit legibly on every
             mark colour in both themes without needing their own palette.
             Labels stay in the button list: the mark colours are audited as NOT
             text-safe, and at phone size map text would be ~6px anyway. -->

        <!-- Northwest: forest -->
        <g class="rgn" data-rgn="wildwood">
          <rect x="42" y="42" width="252" height="222" rx="26" fill="var(--mark-wildwood)"
          ></rect>
          <g class="glyph">
            <path d="M132 176 l22-42 22 42 z"></path>
            <rect x="150" y="176" width="8" height="16" rx="2"></rect>
            <path d="M170 186 l26-50 26 50 z"></path>
            <rect x="192" y="186" width="8" height="18" rx="2"></rect>
            <path d="M112 196 l18-34 18 34 z"></path>
            <rect x="126" y="196" width="7" height="14" rx="2"></rect>
          </g>
        </g>

        <!-- Northeast: highland crag -->
        <g class="rgn" data-rgn="frostwatch">
          <rect
            x="304"
            y="42"
            width="252"
            height="222"
            rx="26"
            fill="var(--mark-frostwatch)"></rect>
          <g class="glyph">
            <path d="M368 194 l44-76 44 76 z"></path>
            <path d="M430 194 l34-58 34 58 z"></path>
          </g>
          <g class="glyph glyph--light">
            <path d="M398 142 l14-24 14 24 -14 -7 z"></path>
          </g>
        </g>

        <!-- Southwest: mire -->
        <g class="rgn" data-rgn="miregate">
          <rect
            x="42"
            y="276"
            width="252"
            height="222"
            rx="26"
            fill="var(--mark-miregate)"></rect>
          <g class="glyph glyph--stroke">
            <path d="M104 372 q22-16 44 0 t44 0 t44 0"></path>
            <path d="M104 404 q22-16 44 0 t44 0 t44 0"></path>
            <path d="M104 436 q22-16 44 0 t44 0 t44 0"></path>
          </g>
        </g>

        <!-- Southeast: farmland -->
        <g class="rgn" data-rgn="sunmere">
          <rect x="304" y="276" width="252" height="222" rx="26" fill="var(--mark-gold)"
          ></rect>
          <g class="glyph">
            <rect x="352" y="358" width="156" height="12" rx="6"></rect>
            <rect x="352" y="386" width="156" height="12" rx="6"></rect>
            <rect x="352" y="414" width="156" height="12" rx="6"></rect>
            <rect x="352" y="442" width="104" height="12" rx="6"></rect>
          </g>
        </g>

        <!-- Far east: the dungeon. Its own strip, reached by the longest road. -->
        <g class="rgn" data-rgn="cinder">
          <rect x="586" y="180" width="92" height="180" rx="18" fill="var(--mark-cinder)"
          ></rect>
          <g class="glyph">
            <path d="M612 300 v-44 a20 20 0 0 1 40 0 v44 z"></path>
          </g>
          <g class="glyph glyph--light">
            <path d="M632 292 q-11-10 0-24 q11 10 0 24 z"></path>
          </g>
        </g>

        <!-- Routes: drawn before the settlement so the plaza sits on top. -->
        <g
          stroke="currentColor"
          stroke-width="2"
          stroke-dasharray="6 7"
          fill="none"
          opacity="0.75"
        >
          <path d="M299 270 L168 153" data-draw data-draw-delay="0"></path>
          <path d="M299 270 L430 153" data-draw data-draw-delay="90"></path>
          <path d="M299 270 L168 387" data-draw data-draw-delay="180"></path>
          <path d="M299 270 L430 387" data-draw data-draw-delay="270"></path>
          <path
            d="M299 270 L586 270"
            data-draw
            data-draw-delay="380"
            data-draw-duration="1200"></path>
        </g>

        <!-- Centre: the settlement itself, as buildings around a hearth. -->
        <g class="rgn" data-rgn="hearthvale">
          <circle
            cx="299"
            cy="270"
            r="54"
            fill="var(--surface-raised)"
            stroke="currentColor"
            stroke-width="2.5"></circle>
          <g class="glyph glyph--town">
            <path d="M272 268 l12-11 12 11 v14 h-24 z"></path>
            <path d="M302 262 l11-10 11 10 v20 h-22 z"></path>
            <path d="M285 288 l10-9 10 9 v11 h-20 z"></path>
          </g>
          <circle cx="299" cy="246" r="7" fill="var(--mark-gold)"></circle>
        </g>
      </svg>

      <ul class="world__list">
        {
          districts.map((d) => (
            <li>
              <button
                class="district"
                type="button"
                data-district={d.id}
                aria-expanded="false"
              >
                <span
                  class={
                    d.mod ? `chip-district chip-district--${d.mod}` : "chip-district"
                  }
                >
                  {d.name}
                </span>
                <span class="district__role">{d.role}</span>
              </button>
              <p class="district__body" data-body={d.id} hidden>
                {d.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .world {
    padding-block: var(--space-3xl);
  }

  .world__lede {
    color: var(--text-muted);
    margin-block: var(--space-sm) var(--space-xl);
  }

  .world__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 62rem) {
    .world__grid {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .world__map {
    width: 100%;
    height: auto;
    /* currentColor drives the survey grid, the frame and the routes, so the
       whole map follows the theme from one declaration. */
    color: var(--text-muted);
  }

  /* Glyphs. Translucent black reads on every mark colour in both themes, which
     a fixed palette colour would not. */
  .world__map .glyph {
    fill: rgb(0 0 0 / 0.34);
  }

  .world__map .glyph--light {
    fill: rgb(255 255 255 / 0.7);
  }

  .world__map .glyph--stroke {
    fill: none;
    stroke: rgb(0 0 0 / 0.34);
    stroke-width: 5;
    stroke-linecap: round;
  }

  /* The settlement sits on a surface plate rather than a mark colour, so its
     buildings use the text token and stay legible in both themes. */
  .world__map .glyph--town {
    fill: var(--text-muted);
  }

  /* Regions dim when any sibling is active, so the highlighted one reads
     without needing a colour nobody else has. */
  .world__map .rgn {
    opacity: 0.72;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Dimmed, but not so far that the glyphs stop reading — they carry the
     meaning of each region, which flat colour did not. */
  .world__map[data-active] .rgn {
    opacity: 0.45;
  }

  .world__map .rgn.is-active {
    opacity: 1;
    transform: translateY(-4px) scale(1.015);
  }

  .world__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .district {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    text-align: left;
    padding: var(--space-xs);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out);
  }

  .district:hover,
  .district[aria-expanded="true"] {
    background: var(--surface-raised);
    border-color: var(--border-subtle);
  }

  .district__role {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .district__body {
    color: var(--text-body);
    font-size: var(--text-sm);
    padding: 0 var(--space-xs) var(--space-sm) calc(var(--space-xs) + var(--space-sm));
    max-width: none;
  }
</style>

<script>
  const map = document.querySelector<SVGElement>("[data-map]");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".district[data-district]"),
  );

  function setActive(id: string | null): void {
    map?.querySelectorAll(".rgn").forEach((g) => {
      g.classList.toggle("is-active", id !== null && g.getAttribute("data-rgn") === id);
    });
    if (map) {
      if (id) map.setAttribute("data-active", "");
      else map.removeAttribute("data-active");
    }
  }

  function open(id: string | null): void {
    for (const btn of buttons) {
      const mine = btn.dataset.district === id;
      btn.setAttribute("aria-expanded", String(mine));
      const body = document.querySelector<HTMLElement>(
        `[data-body="${btn.dataset.district}"]`,
      );
      if (body) body.hidden = !mine;
    }
    setActive(id);
  }

  for (const btn of buttons) {
    const id = btn.dataset.district ?? null;

    // Click toggles the description. Hover and keyboard focus only highlight
    // the map — moving focus through the list should not expand six paragraphs.
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      open(isOpen ? null : id);
    });

    btn.addEventListener("mouseenter", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(id);
    });
    btn.addEventListener("focus", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(id);
    });
    btn.addEventListener("mouseleave", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(null);
    });
  }

  // Open the settlement by default: an empty panel beside a dimmed map looks
  // broken, and Hearthvale is where the game actually starts.
  open("hearthvale");
</script>
