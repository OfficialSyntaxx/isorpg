---
/**
 * §5.4 — the mainland.
 *
 * WHAT CHANGED, AND WHY
 * This section used to draw its own map: six flat rounded rectangles in an
 * SVG, each with a small symbolic glyph, that lit up one at a time. The fair
 * criticism of it was that the highlight was the only thing happening — the
 * shapes carried no information a colour swatch does not, so "showing the
 * world" amounted to pointing at a bar chart and naming the bars. Nothing about
 * it was specific to Isoperia.
 *
 * The project already has a picture of the actual mainland: the illustrated
 * overworld layout the world is greyboxed against, with the walled settlement
 * and its fountain at the centre, pine forest and standing stones northwest,
 * a snow-capped mine northeast, a dead-tree bog southwest, ploughed fields and
 * a windmill southeast, and a violet-lit ruin on the eastern shore. Every claim
 * in the region copy below is visible in it. So the map is that image, and
 * selecting a region spotlights it — the surrounding world dims, the chosen
 * ground stays lit, and you can see the trees, the snow line and the fields
 * that the words describe.
 *
 * It is labelled "Concept art" by MediaFigure and cannot be un-labelled: this
 * is the layout the world is built to, not a screenshot of it, and a visitor
 * deciding whether to play deserves to know which they are looking at.
 *
 * ACCESSIBILITY — WHY THE BUTTONS ARE STILL THE INTERACTIVE LAYER
 * Unchanged, and the reason is unchanged. Blueprint §9.2 rules out a map that
 * only works with a mouse. Rather than bolt roles and tabindex onto shapes, the
 * real controls are ordinary buttons; the overlay is decorative and reacts to
 * them. Keyboard and screen-reader support come free from the button element,
 * and the list is itself the text equivalent, so there is no separate
 * "accessible version" to drift.
 *
 * The overlay geometry is in percentages of the artwork, which is square, so it
 * needs no reflow rules — it is correct at every width by construction.
 */
import MediaFigure from "../MediaFigure.astro";

const districts = [
  {
    id: "hearthvale",
    name: "Hearthvale",
    role: "Safe home and construction",
    body: "The walled centre. An open plaza around the fountain, a market, a campfire and the build plots — buildings sit around the square rather than ringing you in. Every road on the map starts here.",
    mod: "",
    /** Spotlight, in percent of the artwork. Placed against the illustration. */
    at: { cx: 48, cy: 45, rx: 15, ry: 13 },
  },
  {
    id: "wildwood",
    name: "Wildwood",
    role: "First gathering route",
    body: "Northwest forest. Normal and oak stands, the standing-stone ruin as the arrival landmark, and the early wildlife that teaches you to watch your health.",
    mod: "wildwood",
    at: { cx: 21, cy: 16, rx: 17, ry: 14 },
    /** Where the road bends, taken off the bridge or pass in the artwork. */
    via: { x: 34, y: 29 },
  },
  {
    id: "frostwatch",
    name: "Frostwatch",
    role: "Mining progression",
    body: "Northeast highlands. Copper and tin near the road, iron and coal deeper in. The mine head and the snow line are both visible from the route, so you can see how far up you are choosing to go.",
    mod: "frostwatch",
    at: { cx: 79, cy: 14, rx: 19, ry: 13 },
    /** Where the road bends, taken off the bridge or pass in the artwork. */
    via: { x: 62, y: 28 },
  },
  {
    id: "miregate",
    name: "Miregate",
    role: "Mid-game route",
    body: "Southwest mire. Willow stands, fishing water, bog husks, and hazardous paths where finding the crossing matters more than winning the fight.",
    mod: "miregate",
    at: { cx: 19, cy: 74, rx: 17, ry: 15 },
    /** Where the road bends, taken off the bridge or pass in the artwork. */
    via: { x: 34, y: 61 },
  },
  {
    id: "sunmere",
    name: "Sunmere",
    role: "Food and town growth",
    body: "Southeast lowlands. Farm plots and fishing feed the cooking and carpentry loop; the mill and granary anchor the shoreline and mark how far the town has grown.",
    mod: "wildwood",
    at: { cx: 78, cy: 76, rx: 19, ry: 16 },
    /** Where the road bends, taken off the bridge or pass in the artwork. */
    via: { x: 63, y: 61 },
  },
  {
    id: "cinder",
    name: "Cinder Hollow",
    role: "High-risk destination",
    body: "The far east ruin, lit in pools. The longest road on the map and the only one that is not a gentle loop — this is the route you earn.",
    mod: "cinder",
    at: { cx: 86, cy: 45, rx: 11, ry: 10 },
    /** Where the road bends, taken off the bridge or pass in the artwork. */
    via: { x: 67, y: 44 },
  },
] as const;
---

<section class="world seam" data-region="wildwood" id="world">
  <div class="wrap">
    <p class="eyebrow">The mainland</p>
    <h2 data-reveal>One place, six ways it changes</h2>
    <p class="world__lede" data-reveal>
      A safe centre, landmark-led roads, four outer regions whose terrain, resources and
      danger reinforce one another, and a dungeon east. Pick one and the map dims around
      it.
    </p>

    <div class="world__grid">
      <div class="world__atlas" data-reveal>
        <MediaFigure
          id="overworld-layout"
          widths={[640, 960, 1280]}
          sizes="(min-width: 62rem) 44rem, 100vw"
        >
          <svg
            class="atlas"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
            data-map
          >
            <defs>
              {
                /* A hard-edged spotlight looks like a cut-out sticker. The blur
                   is what makes it read as light falling on the map. */
              }
              <filter id="atlas-soft" x="-25%" y="-25%" width="150%" height="150%">
                <feGaussianBlur stdDeviation="3.2"></feGaussianBlur>
              </filter>

              {
                /* White keeps the scrim; black holes punch through to the art.
                   Each hole is invisible until its region is chosen, so the
                   default state is the whole map, undimmed. */
              }
              <mask id="atlas-spot">
                <rect width="100" height="100" fill="#fff"></rect>
                <g filter="url(#atlas-soft)">
                  {
                    districts.map((d) => (
                      <ellipse
                        class="atlas__hole"
                        data-rgn={d.id}
                        cx={d.at.cx}
                        cy={d.at.cy}
                        rx={d.at.rx}
                        ry={d.at.ry}
                        fill="#000"
                      />
                    ))
                  }
                </g>
              </mask>
            </defs>

            <rect
              class="atlas__scrim"
              width="100"
              height="100"
              mask="url(#atlas-spot)"
              fill="#05070e"></rect>

            {
              /* The roads, drawn on first view.
                 These are the routes the copy keeps referring to — "every route
                 is a loop back to town" — and until you watch them leave the
                 settlement, that sentence is only a claim. They bend outward to
                 follow the bridges and passes in the artwork rather than cutting
                 straight across water.

                 initPathDraw measures each path and animates stroke-dashoffset;
                 data-draw-delay staggers the departures. The eastern road takes
                 longer on purpose — it is the one route that is not a gentle
                 loop, and it should feel like the longer walk it is. */
            }
            <g class="atlas__roads">
              {
                districts
                  .filter((d) => "via" in d)
                  .map((d, i) => (
                    <path
                      class="atlas__road"
                      data-rgn={d.id}
                      d={`M48 45 Q ${d.via.x} ${d.via.y} ${d.at.cx} ${d.at.cy}`}
                      data-draw
                      data-draw-delay={i * 120}
                      data-draw-duration={d.id === "cinder" ? 1400 : 900}
                    />
                  ))
              }
            </g>

            {
              /* Route pins. Faint at rest so the map always looks surveyed
                 rather than blank, and the chosen one rides up on the light. */
            }
            <g class="atlas__pins">
              {
                districts.map((d) => (
                  <g class="atlas__pin" data-rgn={d.id}>
                    <circle class="atlas__ring" cx={d.at.cx} cy={d.at.cy} r="2.6" />
                    <circle class="atlas__dot" cx={d.at.cx} cy={d.at.cy} r="0.9" />
                  </g>
                ))
              }
            </g>
          </svg>
        </MediaFigure>
      </div>

      <ul class="world__list">
        {
          districts.map((d) => (
            <li>
              <button
                class="district"
                type="button"
                data-district={d.id}
                aria-expanded="false"
              >
                <span
                  class={
                    d.mod ? `chip-district chip-district--${d.mod}` : "chip-district"
                  }
                >
                  {d.name}
                </span>
                <span class="district__role">{d.role}</span>
              </button>
              <p class="district__body" data-body={d.id} hidden>
                {d.body}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .world {
    padding-block: var(--space-3xl);
  }

  .world__lede {
    color: var(--text-muted);
    margin-block: var(--space-sm) var(--space-xl);
  }

  .world__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 62rem) {
    .world__grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .atlas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Decorative and reactive only — the buttons are the controls, and a
       pointer landing here should not eat their clicks. */
    pointer-events: none;
  }

  /* Nothing is dimmed until a region is chosen: the first thing a visitor sees
     is the whole island. */
  .atlas__scrim {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .atlas[data-active] .atlas__scrim {
    opacity: 0.68;
  }

  .atlas__hole {
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .atlas__hole.is-active {
    opacity: 1;
  }

  /* Scaled rather than animated through the `r` attribute: CSS geometry
     properties are not universally supported, and a transform is composited. */
  /* Roads sit under the scrim's logic but over the art: faint enough to read as
     a surveyor's overlay, bright on the road you have chosen. */
  .atlas__road {
    fill: none;
    stroke: #fff;
    stroke-width: 0.45;
    stroke-linecap: round;
    opacity: 0.26;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .atlas[data-active] .atlas__road {
    opacity: 0.16;
  }

  .atlas[data-active] .atlas__road.is-active {
    opacity: 0.85;
  }

  .atlas__ring {
    fill: none;
    stroke: #fff;
    stroke-width: 0.5;
    opacity: 0.5;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .atlas__dot {
    fill: #fff;
    opacity: 0.75;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  /* Unchosen pins fade rather than vanish, so the map keeps its survey marks
     and you can still see where else there is to go. */
  .atlas[data-active] .atlas__pin {
    opacity: 0.28;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .atlas[data-active] .atlas__pin.is-active {
    opacity: 1;
  }

  .atlas__pin.is-active .atlas__ring {
    opacity: 1;
    transform: scale(1.55);
  }

  .atlas__pin.is-active .atlas__dot {
    opacity: 1;
  }

  /* No reduced-motion block: every duration above is a token, and tokens.css
     collapses them all to 0.01ms under the media query. One place, not seven. */

  .world__list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .district {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    text-align: left;
    padding: var(--space-xs);
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition:
      background-color var(--dur-quick) var(--ease-out),
      border-color var(--dur-quick) var(--ease-out);
  }

  .district:hover,
  .district[aria-expanded="true"] {
    background: var(--surface-raised);
    border-color: var(--border-subtle);
  }

  .district__role {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .district__body {
    color: var(--text-body);
    font-size: var(--text-sm);
    padding: 0 var(--space-xs) var(--space-sm) calc(var(--space-xs) + var(--space-sm));
    max-width: none;
  }
</style>

<script>
  const map = document.querySelector<SVGElement>("[data-map]");
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".district[data-district]"),
  );

  function setActive(id: string | null): void {
    map?.querySelectorAll(".atlas__hole, .atlas__pin, .atlas__road").forEach((el) => {
      el.classList.toggle("is-active", id !== null && el.getAttribute("data-rgn") === id);
    });
    if (map) {
      if (id) map.setAttribute("data-active", "");
      else map.removeAttribute("data-active");
    }
  }

  function open(id: string | null): void {
    for (const btn of buttons) {
      const mine = btn.dataset.district === id;
      btn.setAttribute("aria-expanded", String(mine));
      const body = document.querySelector<HTMLElement>(
        `[data-body="${btn.dataset.district}"]`,
      );
      if (body) body.hidden = !mine;
    }
    setActive(id);
  }

  for (const btn of buttons) {
    const id = btn.dataset.district ?? null;

    // Click toggles the description. Hover and keyboard focus only move the
    // spotlight — tabbing through the list should not expand six paragraphs.
    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      open(isOpen ? null : id);
    });

    btn.addEventListener("mouseenter", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(id);
    });
    btn.addEventListener("focus", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(id);
    });
    btn.addEventListener("mouseleave", () => {
      if (!document.querySelector('.district[aria-expanded="true"]')) setActive(null);
    });
  }

  // Open the settlement by default: an empty panel beside an undimmed map looks
  // like a control that does nothing, and Hearthvale is where the game starts.
  open("hearthvale");
</script>
