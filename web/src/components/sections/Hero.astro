---
/**
 * §5.1 — Hero: "the world builds itself."
 *
 * The terrain behind the headline is genuinely generated in the browser, not a
 * video loop or a screenshot. That is the honest hook: the game's premise is
 * that every mesh and texture is produced at runtime from primitives, so the
 * page that sells it should generate too.
 *
 * FALLBACK IS A DESIGN, NOT A DEGRADATION
 * The canvas is progressive enhancement. The gradient beneath it is a complete,
 * deliberate composition on its own, so anyone with no canvas, reduced motion,
 * save-data on, or a failed script gets a page that looks finished rather than
 * broken. The script paints one static frame; blueprint Phase 5 (M1) adds the
 * staggered rise and the ambient day/night wash.
 */
import SplitText from "../SplitText.astro";
import { site, gamePath } from "../../lib/site";
---

<section class="hero" data-region="hearth">
  <!-- M2: the terrain drifts against the scroll. 0.5 of the 40px cap, so it
       reads as depth rather than as a parallax demo. -->
  <div class="hero__layer" data-parallax="0.5">
    <!-- M11 — the departure.
         A second, nested transform holder. It exists because the camera move
         below is driven by a scroll TIMELINE while the parallax above is driven
         by a scroll HANDLER writing an inline transform, and a CSS animation
         overrides an inline style: applied to the same element, the camera move
         would silently delete the parallax. Nested, the two transforms compose
         — drift within lift — which is also what they mean. -->
    <div class="hero__depth" data-hero-depth>
      <!-- Two canvases, deliberately.
           The terrain is painted once and never repainted; only the life on top
           of it — water, windows, birds — is redrawn. One canvas meant blitting
           the whole terrain back every frame just to clear what moved, which
           measured 62ms per frame on a throttled phone profile. -->
      <canvas class="hero__canvas" aria-hidden="true" data-hero-terrain></canvas>
      <canvas class="hero__canvas hero__canvas--life" aria-hidden="true" data-hero-life
      ></canvas>
    </div>
  </div>

  <!-- Ambient life over the generated terrain.
       Three drifting cloud shadows at different speeds and sizes, plus a slow
       day/night wash. All of it is compositor-only (transform and opacity), so
       it costs no layout, no repaint and no permanent requestAnimationFrame —
       the terrain underneath is still painted exactly once. -->
  <div class="hero__sky" aria-hidden="true">
    <span class="hero__cloud hero__cloud--a"></span>
    <span class="hero__cloud hero__cloud--b"></span>
    <span class="hero__cloud hero__cloud--c"></span>
    <span class="hero__sun"></span>
  </div>
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="hero__scrim"></div>

  <!-- A3 — the hour, above the scrim.
       The first version of this drove .hero__wash, which sits UNDER the scrim —
       and the scrim paints --surface-page back over most of the frame for text
       legibility, so a night veil under it was almost entirely repainted away.
       Measured: the computed styles were all correct and the picture barely
       changed.

       So the hour gets its own layer above the scrim, and its gradient is
       weighted to the RIGHT: transparent where the headline sits, dark where the
       world is. That is the same division of labour the scrim already makes — the
       left is a reading surface, the right is a window — and it means the world
       can go to night without the text losing its ground. -->
  <div class="hero__hour" aria-hidden="true" data-hero-hour></div>

  <!-- The two layers that only exist during the departure. Both are
       opacity-only, so at rest they cost a composited layer and nothing else.
       Dusk darkens the land you are leaving; the horizon is the light you are
       leaving it for, and it meets the seam at the top of the next section. -->
  <div class="hero__dusk" aria-hidden="true" data-hero-dusk></div>
  <div class="hero__horizon" aria-hidden="true" data-hero-horizon></div>

  <div class="wrap hero__content" data-hero-content>
    <p class="eyebrow" data-reveal>
      Settlement builder · Character RPG · Runs in the browser
    </p>
    {
      /* M12. No data-reveal here: the split IS this heading's entrance, and
         stacking the scroll-reveal fade on top of it would fight the mask. */
    }
    <h1 class="hero__title">
      <SplitText text="The world builds itself." />
    </h1>
    <p class="hero__lede" data-reveal>{site.tagline}</p>

    <div class="hero__actions" data-reveal>
      <a class="btn btn--lg" href={gamePath} data-exit>Play in your browser</a>
      <a class="btn btn--lg btn--secondary" href="#systems">See how it works</a>
    </div>

    <p class="hero__weight" data-reveal>
      Pre-alpha. No install, no account. First load downloads roughly 50&nbsp;MB.
      <br />
      Best on desktop; works on mobile. Chrome, Edge, Firefox or Safari. Saves stay on your
      device.
    </p>

    {
      /* A2 — the world's name.
         Empty until the canvas has actually generated something, because a
         label for a world nobody can see is noise. The id is an <a> to the same
         page with ?world=, so right-click-copy-link shares this exact world and
         a click re-enters it deliberately. That is deliberately NOT a
         history.replaceState on load: rewriting someone's address bar so they
         bookmark a URL they never chose is a bigger liberty than the feature is
         worth. */
    }
    <p class="hero__world" data-hero-world></p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88svh, 820px);
    overflow: hidden;
    /* A complete composition without the canvas: warm ground rising into the
       dusk-blue of the game's own HUD. */
    background:
      radial-gradient(120% 80% at 50% 110%, var(--surface-sunken) 0%, transparent 60%),
      linear-gradient(180deg, var(--surface-page) 0%, var(--surface-sunken) 100%);
  }

  /* The parallax transform lives on a wrapper, not the canvas: transforming
     the canvas itself would force it to re-rasterise its backing store on
     every frame. */
  .hero__layer {
    position: absolute;
    inset: -6% 0;
    will-change: transform;
  }

  .hero__depth {
    position: absolute;
    inset: 0;
    /* Growth pushes down and outward past the viewer rather than away from a
       centre point, which is what makes the move read as descending into the
       land instead of the land being zoomed. */
    transform-origin: 50% 30%;
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ---------------------------------------------------------------------
     M11 — THE DEPARTURE
     ---------------------------------------------------------------------
     The signature scroll moment: leaving the hero is a camera move, not a
     section scrolling off.

     Three things happen at different rates, which is the whole effect. The
     words go first and clear the frame. The land keeps going a moment longer,
     growing and settling as you drop into it. And dusk closes over it while a
     warm horizon opens underneath — arriving at the seam that starts the next
     section, so the join reads as cresting a rise rather than as a boundary
     between two blocks of a page.

     WHY IT IS BUILT THIS WAY

     It is driven by a scroll TIMELINE, not a scroll handler. The animations run
     on the compositor, so they stay smooth while the main thread is busy — and
     the main thread here is busy, generating a world. A JavaScript version
     would add a fifth scroll listener and put a camera move on the same thread
     as the terrain generator, which is exactly the trade that cost this hero
     6,951ms once already.

     It costs 356 bytes of gzipped CSS and no JavaScript at all — measured, by
     building with and without this block. There is no library and no new
     script; the machinery is CSS the browser already ships.

     Everything is transform and opacity. No layout, no repaint, no CLS.

     PROGRESSIVE ENHANCEMENT IS THE POINT, NOT A CAVEAT
     Support is broad but not universal — Firefox still has this behind a flag.
     So the whole block is inside @supports, and every property it touches has a
     resting value that is already correct. A browser without scroll timelines
     does not get a degraded hero; it gets today's hero, unchanged, and nothing
     in the markup hints that it is missing anything.

     Durations are deliberately absent. A timeline-driven animation needs
     `animation-duration: auto`, and the `animation` shorthand would reset it to
     0s and silently freeze every keyframe on its first frame. Longhands only,
     for that reason.

     REDUCED MOTION NEEDS AN EXPLICIT BLOCK HERE
     Elsewhere in this project the duration tokens collapse under the media
     query and that is enough. Scroll-driven animations have no duration to
     collapse: their progress comes from the scroll position, so they would run
     at full strength regardless. The media query below is load-bearing, not
     ceremonial. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__content {
        animation-name: hero-depart;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        /* Ends as the last line clears the top of the viewport. Text that
           fades while still comfortably readable feels like a fault. */
        animation-range: 4svh 62svh;
      }

      .hero__depth {
        animation-name: hero-lift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 100svh;
      }

      .hero__dusk {
        animation-name: hero-dusk;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 8svh 96svh;
      }

      .hero__horizon {
        animation-name: hero-horizon;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 12svh 88svh;
      }
    }
  }

  @keyframes hero-depart {
    from {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
    to {
      opacity: 0;
      transform: translate3d(0, -7%, 0);
    }
  }

  /* 1.12, not 1.4. §6.2 caps displacement because large parallax on a marketing
     page is the single most common tell that a template is underneath. The same
     restraint applies to a camera move: this should be felt, not watched. */
  @keyframes hero-lift {
    from {
      transform: scale(1) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.12) translate3d(0, 3%, 0);
    }
  }

  @keyframes hero-dusk {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.62;
    }
  }

  @keyframes hero-horizon {
    from {
      opacity: 0;
      transform: scaleY(0.35);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  .hero__dusk {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    /* A literal, not a token. Dusk has to fall in BOTH themes — every dark
       surface token in this project inverts, and --surface-sunken in the light
       theme is a warm cream, so a tokenised version of this layer would
       brighten the page instead of darkening it. This is the dark theme's page
       colour, used deliberately as a colour rather than as a role. */
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, #0b1220 40%, transparent) 55%,
      color-mix(in srgb, #0b1220 78%, transparent) 100%
    );
  }

  .hero__horizon {
    position: absolute;
    inset-inline: -10%;
    bottom: -1px;
    height: 34%;
    pointer-events: none;
    opacity: 0;
    transform-origin: 50% 100%;
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--mark-gold) 16%, transparent) 48%,
      color-mix(in srgb, var(--mark-gold) 52%, transparent) 86%,
      color-mix(in srgb, var(--mark-gold) 22%, transparent) 100%
    );
    filter: blur(18px);
  }

  /* Both layers are pure light. Without color-mix they would be flat blocks of
     gold and ink across the bottom of the hero, so they simply do not appear. */
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    .hero__dusk,
    .hero__horizon {
      display: none;
    }
  }

  /* Soft shadows drifting across the land. Sized in vmax so they stay
     proportionate from a phone to an ultrawide. */
  .hero__cloud {
    position: absolute;
    border-radius: 50%;
    /* A cloud shadow darkens; it does not tint. */
    background: radial-gradient(
      circle at 50% 50%,
      rgb(0 0 0 / 0.28) 0%,
      rgb(0 0 0 / 0.14) 45%,
      transparent 70%
    );
    filter: blur(18px);
    will-change: transform;
  }

  .hero__cloud--a {
    width: 62vmax;
    height: 34vmax;
    top: -6%;
    left: -30%;
    animation: drift-a 78s linear infinite;
  }

  .hero__cloud--b {
    width: 44vmax;
    height: 24vmax;
    top: 28%;
    left: -40%;
    opacity: 0.75;
    animation: drift-b 116s linear infinite;
  }

  .hero__cloud--c {
    width: 80vmax;
    height: 40vmax;
    top: 52%;
    left: -55%;
    opacity: 0.55;
    animation: drift-c 152s linear infinite;
  }

  /* A single warm highlight that breathes, so the scene has a light source
     rather than just moving darkness. */
  .hero__sun {
    position: absolute;
    top: -18%;
    right: -10%;
    width: 58vmax;
    height: 58vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--mark-gold) 26%, transparent) 0%,
      transparent 62%
    );
    animation: breathe 42s var(--ease-in-out) infinite alternate;
  }

  /* Diagonal travel, matching the isometric grain of the terrain so the
     shadows look like they belong to the same world. */
  @keyframes drift-a {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(190vmax, 26vmax, 0);
    }
  }

  @keyframes drift-b {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(200vmax, -18vmax, 0);
    }
  }

  @keyframes drift-c {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(220vmax, 14vmax, 0);
    }
  }

  @keyframes breathe {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0.95;
      transform: scale(1.12);
    }
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--ink-900, #0b1220) 55%, transparent) 0%,
      transparent 45%,
      color-mix(in srgb, var(--mark-gold) 12%, transparent) 100%
    );
    opacity: 0.5;
    animation: wash 90s var(--ease-in-out) infinite alternate;
  }

  @keyframes wash {
    from {
      opacity: 0.28;
    }
    to {
      opacity: 0.62;
    }
  }

  /* Reduced motion keeps the composition and stops the movement. The clouds
     and the sun remain as static light and shade, so the scene still reads as
     a lit world rather than losing a layer. */
  @media (prefers-reduced-motion: reduce) {
    .hero__wash,
    .hero__cloud,
    .hero__sun {
      animation: none;
    }

    .hero__wash {
      opacity: 0.4;
    }

    .hero__cloud--a {
      transform: translate3d(40vmax, 6vmax, 0);
    }
    .hero__cloud--b {
      transform: translate3d(70vmax, -4vmax, 0);
    }
    .hero__cloud--c {
      transform: translate3d(55vmax, 4vmax, 0);
    }
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Held back until the script has painted, so an empty canvas never covers
       the fallback gradient. */
    opacity: 0;
    transition: opacity var(--dur-world) var(--ease-out);
  }

  .hero__canvas[data-painted] {
    opacity: 1;
  }

  /* The life layer sits directly over the terrain and shares its fade-in. */
  .hero__canvas--life {
    opacity: 1;
    transition: none;
  }

  .hero__canvas:not([data-painted]) + .hero__canvas--life {
    opacity: 0;
  }

  /* Keeps the headline legible over whatever the generator produced. Without
     this the contrast of the title depends on a random seed, which is not a
     thing to leave to chance. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      var(--surface-page) 0%,
      color-mix(in srgb, var(--surface-page) 88%, transparent) 42%,
      color-mix(in srgb, var(--surface-page) 46%, transparent) 72%,
      transparent 100%
    );
  }

  /* THE NARROW-SCREEN VEIL.
   *
   * The 100deg gradient above encodes a deliberate split: keep the left
   * readable for the headline, let the right show the world. That split only
   * works while the text column is narrower than the hero. On a phone the text
   * spans the full width, so long lines run straight into the gradient's
   * transparent end and are set over raw terrain.
   *
   * Measured at 390px with the expectations line added in Phase 15f: worst-case
   * contrast 1.01:1 in light and 1.08:1 in dark — not "low contrast", invisible.
   * Lighthouse scores accessibility 100 on this page and cannot see it, because
   * it reads the computed background-color of the element, which is transparent;
   * the thing behind the text is canvas pixels.
   *
   * So below 45rem the scrim stops being a side-to-side split and becomes a
   * top-to-bottom veil: the world still reads through the upper part of the
   * frame, and the half that carries text is nearly opaque.
   */
  @media (max-width: 45rem) {
    .hero__scrim {
      background: linear-gradient(
        176deg,
        color-mix(in srgb, var(--surface-page) 18%, transparent) 0%,
        color-mix(in srgb, var(--surface-page) 55%, transparent) 20%,
        color-mix(in srgb, var(--surface-page) 80%, transparent) 42%,
        color-mix(in srgb, var(--surface-page) 84%, transparent) 100%
      );
    }
  }

  /* color-mix is well supported but not universal; without it the scrim would
     be a hard wall of solid colour across the whole hero. */
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    .hero__scrim {
      background: linear-gradient(
        100deg,
        var(--surface-page) 0%,
        var(--surface-page) 40%,
        transparent 85%
      );
      opacity: 0.92;
    }
  }

  .hero__content {
    position: relative;
    padding-block: var(--space-4xl);
  }

  .hero__title {
    font-size: var(--text-4xl);
    max-width: 22ch;
    margin-bottom: var(--space-md);
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--text-body);
    max-width: 42ch;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__weight {
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  /* The space is reserved before there is anything to put in it.
     This shipped as `hidden` and filled in once the generator returned a seed,
     which added a line of text to the hero a second or two after load and took
     cumulative layout shift on the landing page from 0.005 to 0.307 - enough to
     cost 16 points of mobile performance. Caught by the production Lighthouse
     gate, not by looking at it, because a shift that happens before you scroll
     is invisible unless you are measuring.

     min-height reserves exactly one line and the reveal is opacity only, so the
     box never changes size. */
  .hero__world {
    margin-top: var(--space-2xs);
    min-height: 1lh;
    color: var(--text-muted);
    font-size: var(--text-2xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-caps);
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .hero__world[data-named] {
    opacity: 1;
  }

  /* 1lh is recent. Without it, one line at this size and line-height. */
  @supports not (min-height: 1lh) {
    .hero__world {
      min-height: 1.4em;
    }
  }

  .hero__world :global(a) {
    color: inherit;
    text-underline-offset: 0.25em;
    text-decoration-color: var(--border-strong);
  }

  .hero__world :global(a:hover) {
    color: var(--text-body);
  }

  /* ---------------------------------------------------------------------
     A3 — THE HERO KEEPS THE VISITOR'S CLOCK
     ---------------------------------------------------------------------
     The sun breathed on a 42s loop and the wash on a 90s loop. Both were
     arbitrary numbers standing in for time passing, on a page whose whole
     claim is that the world is generated rather than drawn.

     The scene now reads the visitor's own hour. Four parts, chosen to match
     how the light actually changes rather than to split the day evenly: a
     narrow warm dawn, a long flat day, a short intense dusk, and a long night
     where the settlement's windows do the work.

     It costs one Date call. Everything below is the existing sun and wash
     elements taking different values — no new layers, no new requests, and the
     canvas underneath is untouched, so none of this affects the terrain the
     generator produced.

     The game has its own day clock (a DAY_START_MINUTE and a minute counter),
     so this reflects a real system rather than inventing an effect. It is not
     synchronised to it: the game's day is a game-length day, and matching the
     player's wall clock is the point here. */
  :root[data-daypart="dawn"] .hero__sun {
    top: 8%;
    right: 6%;
    width: 44vmax;
    height: 44vmax;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--mark-cinder) 30%, transparent) 0%,
      transparent 62%
    );
  }

  :root[data-daypart="dusk"] .hero__sun {
    top: 26%;
    right: -4%;
    width: 52vmax;
    height: 52vmax;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--mark-cinder) 38%, transparent) 0%,
      transparent 58%
    );
  }

  /* No sun at night. The moon is not worth a layer; an absence reads correctly
     on its own, and the window lights become the brightest thing on screen,
     which is exactly what should happen. */
  :root[data-daypart="night"] .hero__sun {
    opacity: 0.16;
    top: 4%;
    right: 14%;
    width: 26vmax;
    height: 26vmax;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--mark-frostwatch) 34%, transparent) 0%,
      transparent 60%
    );
    animation: none;
  }

  .hero__hour {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    /* Crossfaded rather than switched, so a visitor who crosses an hour
       boundary with the page open sees the light change rather than jump. */
    transition: opacity var(--dur-world) linear;
  }

  /* Day is the resting state and adds nothing: an overlay at zero opacity. */
  :root[data-daypart="dawn"] .hero__hour {
    opacity: 0.5;
    background: linear-gradient(
      100deg,
      transparent 0%,
      transparent 34%,
      color-mix(in srgb, #2a2340 44%, transparent) 74%,
      color-mix(in srgb, #3a2a44 52%, transparent) 100%
    );
  }

  :root[data-daypart="dusk"] .hero__hour {
    opacity: 0.66;
    background: linear-gradient(
      100deg,
      transparent 0%,
      transparent 30%,
      color-mix(in srgb, #7a3a1c 34%, transparent) 68%,
      color-mix(in srgb, #2b1a2e 62%, transparent) 100%
    );
  }

  :root[data-daypart="night"] .hero__hour {
    opacity: 0.88;
    background: linear-gradient(
      100deg,
      transparent 0%,
      transparent 26%,
      color-mix(in srgb, #070d1b 62%, transparent) 62%,
      color-mix(in srgb, #04070f 82%, transparent) 100%
    );
  }

  /* Without color-mix every gradient above collapses, which would leave the
     night hero with no night in it. The unmodified day scene is the fallback. */
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    :root[data-daypart] .hero__sun,
    :root[data-daypart] .hero__hour {
      background: none;
    }
  }
</style>

<script>
  import { paintTerrain, worldLabel } from "../../scripts/hero-terrain";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-terrain]");
  const life = document.querySelector<HTMLCanvasElement>("[data-hero-life]");

  // A3 lives in theme-init.js now, not here.
  //
  // Deciding the daypart in this module meant setting it AFTER load, which
  // changed the sun's top/right/width/height on an already-painted page.
  // Those are layout properties, so the sun moving was a layout shift —
  // Lighthouse attributed 0.29 of a 0.295 CLS to span.hero__sun on its own.
  // It is decided before first paint now, so the hero is correct on frame one.

  if (canvas && life) {
    // Started AFTER the page has loaded and the browser is idle, not during it.
    //
    // Generating the world is real work — noise sampling, a few thousand tiles,
    // then an entrance animation — and running it inline meant it competed with
    // the browser's own first paint of the headline and the buttons. The
    // gradient underneath is a complete composition on its own, so nothing is
    // missing while this waits; the terrain arriving a beat later reads as the
    // world building itself, which is the section's whole idea.
    //
    // requestIdleCallback with a timeout, because Safari has only recently
    // shipped it and the timeout guarantees the world appears on a busy page
    // rather than waiting for an idle moment that never comes.
    const begin = () => {
      const world = paintTerrain(canvas, life);
      if (world === null) return;

      // A2 — name the world, once it exists.
      //
      // Built here rather than in the template because there is nothing to name
      // until the generator has produced something: a seed printed under a
      // canvas that failed to paint is a label for a picture that is not there.
      const slot = document.querySelector<HTMLElement>("[data-hero-world]");
      if (!slot) return;
      const id = worldLabel(world);
      const link = document.createElement("a");
      link.href = `?world=${id}`;
      link.textContent = `#${id}`;
      slot.append("This world: ", link);
      slot.dataset.named = "";
    };
    const schedule = () => {
      if ("requestIdleCallback" in window) {
        (
          window as Window & {
            requestIdleCallback: (cb: () => void, o?: { timeout: number }) => void;
          }
        ).requestIdleCallback(begin, { timeout: 1200 });
      } else {
        setTimeout(begin, 120);
      }
    };

    if (document.readyState === "complete") schedule();
    else window.addEventListener("load", schedule, { once: true });
  }
</script>
