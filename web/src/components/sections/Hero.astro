---
/**
 * §5.1 — Hero: "the world builds itself."
 *
 * The terrain behind the headline is genuinely generated in the browser, not a
 * video loop or a screenshot. That is the honest hook: the game's premise is
 * that every mesh and texture is produced at runtime from primitives, so the
 * page that sells it should generate too.
 *
 * FALLBACK IS A DESIGN, NOT A DEGRADATION
 * The canvas is progressive enhancement. The gradient beneath it is a complete,
 * deliberate composition on its own, so anyone with no canvas, reduced motion,
 * save-data on, or a failed script gets a page that looks finished rather than
 * broken. The script paints one static frame; blueprint Phase 5 (M1) adds the
 * staggered rise and the ambient day/night wash.
 */
import { site, gamePath } from "../../lib/site";
---

<section class="hero">
  <!-- M2: the terrain drifts against the scroll. 0.5 of the 40px cap, so it
       reads as depth rather than as a parallax demo. -->
  <div class="hero__layer" data-parallax="0.5">
    <canvas class="hero__canvas" aria-hidden="true" data-hero-terrain></canvas>
  </div>

  <!-- M1, second half: a very slow day/night wash over the terrain. 90s and
       low amplitude — it should be noticed only if you stay a while, which is
       what "ambient" has to mean to avoid becoming a distraction. -->
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="hero__scrim"></div>

  <div class="wrap hero__content">
    <p class="hero__eyebrow" data-reveal>
      Settlement builder · Character RPG · Runs in the browser
    </p>
    <h1 class="hero__title" data-reveal>The world builds itself.</h1>
    <p class="hero__lede" data-reveal>{site.tagline}</p>

    <div class="hero__actions" data-reveal>
      <a class="btn btn--lg" href={gamePath} data-exit>Play in your browser</a>
      <a class="btn btn--lg btn--secondary" href="#systems">See how it works</a>
    </div>

    <p class="hero__weight" data-reveal>
      No install, no account. First load downloads roughly 50&nbsp;MB.
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88svh, 820px);
    overflow: hidden;
    /* A complete composition without the canvas: warm ground rising into the
       dusk-blue of the game's own HUD. */
    background:
      radial-gradient(120% 80% at 50% 110%, var(--surface-sunken) 0%, transparent 60%),
      linear-gradient(180deg, var(--surface-page) 0%, var(--surface-sunken) 100%);
  }

  /* The parallax transform lives on a wrapper, not the canvas: transforming
     the canvas itself would force it to re-rasterise its backing store on
     every frame. */
  .hero__layer {
    position: absolute;
    inset: -6% 0;
    will-change: transform;
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--ink-900, #0b1220) 55%, transparent) 0%,
      transparent 45%,
      color-mix(in srgb, var(--mark-gold) 12%, transparent) 100%
    );
    opacity: 0.5;
    animation: wash 90s var(--ease-in-out) infinite alternate;
  }

  @keyframes wash {
    from {
      opacity: 0.28;
    }
    to {
      opacity: 0.62;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__wash {
      animation: none;
      opacity: 0.4;
    }
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Held back until the script has painted, so an empty canvas never covers
       the fallback gradient. */
    opacity: 0;
    transition: opacity var(--dur-world) var(--ease-out);
  }

  .hero__canvas[data-painted] {
    opacity: 1;
  }

  /* Keeps the headline legible over whatever the generator produced. Without
     this the contrast of the title depends on a random seed, which is not a
     thing to leave to chance. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      var(--surface-page) 0%,
      color-mix(in srgb, var(--surface-page) 82%, transparent) 42%,
      color-mix(in srgb, var(--surface-page) 30%, transparent) 72%,
      transparent 100%
    );
  }

  /* color-mix is well supported but not universal; without it the scrim would
     be a hard wall of solid colour across the whole hero. */
  @supports not (background: color-mix(in srgb, red 50%, blue)) {
    .hero__scrim {
      background: linear-gradient(
        100deg,
        var(--surface-page) 0%,
        var(--surface-page) 40%,
        transparent 85%
      );
      opacity: 0.92;
    }
  }

  .hero__content {
    position: relative;
    padding-block: var(--space-4xl);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .hero__title {
    font-size: var(--text-4xl);
    max-width: 22ch;
    margin-bottom: var(--space-md);
  }

  .hero__lede {
    font-size: var(--text-lg);
    color: var(--text-body);
    max-width: 42ch;
    margin-bottom: var(--space-xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__weight {
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
</style>

<script>
  import { paintTerrain } from "../../scripts/hero-terrain";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-terrain]");
  if (canvas) paintTerrain(canvas);
</script>
