---
/**
 * The page shell every route uses: head, theme bootstrap, skip link, header,
 * footer.
 *
 * Owns nothing visual beyond layout — the look comes entirely from the Phase 2
 * token and component layers, so a palette change is one edit in tokens.json.
 */
// The typefaces, self-hosted.
//
// These were three families pulled from Google Fonts at runtime: a
// render-blocking stylesheet on one cross-origin host, chaining to font files
// on a second. Lighthouse measured the cost on production as an estimated 2,200ms
// of render-blocking on both pages audited, with first contentful paint and
// largest contentful paint identical at 3.3s — the first paint WAS the paint
// that had finished waiting for Google.
//
// Imported rather than linked, so Vite fingerprints the woff2 files into
// /_astro/ where the existing one-year immutable cache header already applies.
// Every subset ships as an @font-face rule but `unicode-range` means a browser
// downloads only the one it needs; the alternative — hand-written rules for
// latin only — saves a few hundred bytes of CSS and gives up the caching.
//
// This also removes the last third party from the site, which the privacy page
// used to have to disclose, and lets the CSP drop both Google hosts.
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site, absolute, analytics, analyticsEnabled } from "../lib/site";

interface Props {
  /** Page title. The site name is appended, except on the home page. */
  title: string;
  description?: string;
  /** Path of this page, for the canonical URL. */
  pathname: string;
  /** Suppress indexing — used for /play and interim pages. */
  noindex?: boolean;
  /** Home sets its own <h1> and omits the appended site name. */
  isHome?: boolean;
}

const {
  title,
  description = site.tagline,
  pathname,
  noindex = false,
  isHome = false,
} = Astro.props;

const fullTitle = isHome
  ? `${site.name} — ${site.shortDescription}`
  : `${title} · ${site.name}`;
const canonical = absolute(pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} devlog`}
      href="/devlog/rss.xml"
    />
    {noindex && <meta name="robots" content="noindex" />}

    {
      /* Matches --surface-page in each theme so the browser chrome does not
        fight the page on mobile. */
    }
    <meta name="theme-color" content="#F7F2E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b1220'/%3E%3Cpath d='M16 5l10 6-10 6-10-6z' fill='%236aa8ff'/%3E%3Cpath d='M6 13l10 6 10-6v6l-10 6-10-6z' fill='%237cd992'/%3E%3C/svg%3E"
    />

    {
      /* Must stay blocking and must stay in <head>: it applies the saved theme
        before first paint. Deferring it reintroduces the flash it exists to
        prevent. */
    }
    <script is:inline src="/theme-init.js"></script>

    {
      /* Blueprint §10 — cookieless analytics, and only if one is configured.
         `defer` because no page behaviour depends on it, and nothing here sets
         a cookie or reads one. */
      analyticsEnabled() && analytics.provider === "plausible" && (
        <script
          is:inline
          defer
          data-domain={analytics.domain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
    {
      analyticsEnabled() && analytics.provider === "umami" && (
        <script
          is:inline
          defer
          data-website-id={analytics.domain}
          src="https://cloud.umami.is/script.js"
        />
      )
    }
  </head>

  <body>
    {
      /* Region ambience. One layer per district, crossfaded by motion.ts as
         sections come into view, so scrolling reads as travelling outward
         through the world rather than down a document. */
    }
    <div class="ambient" aria-hidden="true">
      <div class="ambient__layer" data-region="hearth" data-ambient="hearth"></div>
      <div class="ambient__layer" data-region="wildwood" data-ambient="wildwood"></div>
      <div class="ambient__layer" data-region="frostwatch" data-ambient="frostwatch">
      </div>
      <div class="ambient__layer" data-region="miregate" data-ambient="miregate"></div>
      <div class="ambient__layer" data-region="cinder" data-ambient="cinder"></div>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // The single motion entry point. This comment ships to every visitor
      // inside the inline module, so it says nothing a reader of the page has
      // no business knowing — the reasoning lives with the module itself.
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
