{
  "name": "isoperia-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Isoperia public website — landing, devlog, world, wiki. The game lives at /play.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "tokens": "node ../scripts/gen-tokens.cjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "astro": "^7.2.8",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "marked": "^18.0.11",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
