# Repository-wide rules.
#
# WHY THIS FILE EXISTS SEPARATELY FROM unity/.gitattributes
# The Unity subtree had LFS rules; the repository root did not. Everything under
# assets/, public/, docs/ and art/ — models, audio, icons, screenshots — was
# therefore committed as raw blobs, which is what a 61 MB .git for a project with
# no shipped build looks like. These rules put binaries where they belong.
#
# GitHub's free LFS allowance is roughly 1 GB of storage and 1 GB of bandwidth a
# month. That is a real ceiling for a 3D game, so the discipline that goes with
# it: commit game-ready assets only. Blender working files, layered textures and
# raw audio stay off the repo (see .gitignore) — they are source, not product.
#
# Adding a rule here does NOT convert files already committed as blobs. To move
# existing history use `git lfs migrate import --include="..."`, which rewrites
# it — coordinate before doing that on a shared branch.

* text=auto eol=lf

# ---- 3D and animation -------------------------------------------------------
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text

# ---- textures and images ----------------------------------------------------
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text

# ---- audio ------------------------------------------------------------------
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.m4a   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text

# ---- archives and fonts -----------------------------------------------------
*.zip   filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# ---- text that must stay text ----------------------------------------------
# Unity YAML must not be LFS'd — UnityYAMLMerge needs to read it to resolve
# conflicts on scenes and prefabs.
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.svg       text eol=lf
